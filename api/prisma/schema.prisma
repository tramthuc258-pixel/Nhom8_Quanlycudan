model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(30)
  apartmentId   String        @map("apartment_id") @db.Uuid
  payerId       String        @map("payer_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  publishedById String?       @map("published_by_id") @db.Uuid
  billingMonth  DateTime      @map("billing_month") @db.Date
  issuedAt      DateTime      @map("issued_at") @db.Timestamptz(6)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(6)
  dueDate       DateTime      @map("due_date") @db.Date
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(15, 2)
  note          String?       @db.Text
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  apartment     Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  payer         User          @relation("InvoicePayer", fields: [payerId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy   User?         @relation("InvoicePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([apartmentId, billingMonth])
  @@index([payerId, status])
  @@index([createdById])
  @@index([publishedById])
  @@index([dueDate, status])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  feeTypeId String?  @map("fee_type_id") @db.Uuid
  name      String   @db.VarChar(150)
  quantity  Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice Decimal  @map("unit_price") @db.Decimal(15, 2)
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeType   FeeType? @relation(fields: [feeTypeId], references: [id], onDelete: SetNull)
    serviceRequest ServiceRequest? @relation("ServiceInvoiceItem")

  @@index([invoiceId])
  @@index([feeTypeId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @map("invoice_id") @db.Uuid
  recordedById    String        @map("recorded_by_id") @db.Uuid
  confirmedById   String?       @map("confirmed_by_id") @db.Uuid
  amount          Decimal       @db.Decimal(15, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionCode String?       @unique @map("transaction_code") @db.VarChar(100)
  proofUrl        String?       @map("proof_url") @db.Text
  note            String?       @db.Text
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy      User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedBy     User?         @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([invoiceId, status])
  @@index([confirmedById])
  @@map("payments")
}

