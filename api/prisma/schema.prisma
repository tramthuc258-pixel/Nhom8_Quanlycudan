generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoleCode {
  RESIDENT
  MANAGEMENT
  ADMIN
  ACCOUNTANT
  RECEPTIONIST
  SECURITY
  TECHNICIAN
}

enum ApartmentStatus {
  OCCUPIED
  VACANT
  UNDER_MAINTENANCE
}

enum MembershipType {
  OWNER
  TENANT
}

enum MembershipStatus {
  ACTIVE
  ENDED
}

enum ResidenceVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HouseholdMemberStatus {
  ACTIVE
  ENDED
}

enum HousingTransactionType {
  RENT
  PURCHASE
}

enum HousingListingStatus {
  PENDING_APPROVAL
  AVAILABLE
  REJECTED
  CLOSED
}

enum HousingApplicationStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum HousingInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum HousingContractStatus {
  SIGNED
  ACTIVE
  ENDED
  CANCELLED
}

enum TemporaryStayStatus {
  PENDING
  APPROVED
  CHECKED_IN
  CHECKED_OUT
  REJECTED
  CANCELLED
  EXPIRED
}

enum SecurityIncidentType {
  NOISE
  DISORDER
  SUSPICIOUS_PERSON
  PROPERTY_DAMAGE
  FIRE_SAFETY
  DISPUTE
  LOST_AND_FOUND
  OTHER
}

enum SecurityIncidentStatus {
  REPORTED
  REVIEWING
  RESOLVED
  CANCELLED
}

enum FeeCalculationType {
  FIXED
  BY_AREA
  BY_QUANTITY
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VNPAY
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  ELEVATOR
  COMMON_AREA
  SECURITY
  OTHER
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  SUBMITTED
  RECEIVED
  IN_PROGRESS
  WAITING_RESIDENT
  COMPLETED
  CANCELLED
}

enum ServiceCategory {
  CLEANING
  LAUNDRY
  TECHNICAL
  TRANSPORTATION
  CONVENIENCE
}

enum ServiceRequestStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  WAITING_RESIDENT
  COMPLETED
  CANCELLED
}

enum AmenityCategory {
  POOL
  GYM
  COMMUNITY_ROOM
  SPORT
  BARBECUE
}

enum AmenityBookingStatus {
  PENDING
  APPROVED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  REJECTED
  CANCELLED
  BLOCKED
}

enum AnnouncementCategory {
  GENERAL
  MAINTENANCE
  BILLING
  EVENT
  EMERGENCY
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementAudience {
  ALL
  RESIDENTS
  MANAGERS
}

enum NotificationType {
  INVOICE
  MAINTENANCE
  HOUSING
  AMENITY
  SERVICE
  SYSTEM
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  email                  String     @unique @db.VarChar(255)
  passwordHash           String     @map("password_hash") @db.VarChar(255)
  fullName               String     @map("full_name") @db.VarChar(150)
  phone                  String?    @db.VarChar(20)
  dateOfBirth            DateTime?  @map("date_of_birth") @db.Date
  contactAddress         String?    @map("contact_address") @db.VarChar(500)
  avatarUrl              String?    @map("avatar_url") @db.Text
  googleSubject          String?    @unique @map("google_subject") @db.VarChar(255)
  mustChangePassword     Boolean    @default(false) @map("must_change_password")
  passwordResetCodeHash  String?    @map("password_reset_code_hash") @db.VarChar(255)
  passwordResetExpiresAt DateTime?  @map("password_reset_expires_at") @db.Timestamptz(6)
  status                 UserStatus @default(ACTIVE)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles                      UserRole[]
  apartmentMemberships           ApartmentMembership[]
  residenceVerificationRequests  ResidenceVerificationRequest[] @relation("ResidenceVerificationRequester")
  reviewedResidenceVerifications ResidenceVerificationRequest[] @relation("ResidenceVerificationReviewer")
  createdHouseholdMembers        HouseholdMember[]              @relation("HouseholdMemberCreator")
  submittedListings              HousingListing[]               @relation("ListingSubmitter")
  reviewedListings               HousingListing[]               @relation("ListingReviewer")
  housingApplications            HousingApplication[]           @relation("HousingApplicant")
  reviewedApplications           HousingApplication[]           @relation("ApplicationReviewer")
  contractsAsOwner               HousingContract[]              @relation("ContractOwner")
  contractsAsCustomer            HousingContract[]              @relation("ContractCustomer")
  recordedContracts              HousingContract[]              @relation("ContractRecorder")
  declaredTemporaryStays         TemporaryStay[]                @relation("TemporaryStayDeclarer")
  reviewedTemporaryStays         TemporaryStay[]                @relation("TemporaryStayReviewer")
  checkedInTemporaryStays        TemporaryStay[]                @relation("TemporaryStayCheckInGuard")
  checkedOutTemporaryStays       TemporaryStay[]                @relation("TemporaryStayCheckOutGuard")
  reportedSecurityIncidents      SecurityIncident[]             @relation("IncidentReporter")
  resolvedSecurityIncidents      SecurityIncident[]             @relation("IncidentResolver")
  assignedSecurityIncidents      SecurityIncident[]             @relation("IncidentAssignee")
  securityIncidentAssignments    SecurityIncident[]             @relation("IncidentAssigner")
  securityIncidentUpdates        SecurityIncidentUpdate[]       @relation("SecurityIncidentUpdateActor")
  invoices                       Invoice[]                      @relation("InvoicePayer")
  createdInvoices                Invoice[]                      @relation("InvoiceCreator")
  publishedInvoices              Invoice[]                      @relation("InvoicePublisher")
  recordedPayments               Payment[]                      @relation("PaymentRecorder")
  confirmedPayments              Payment[]                      @relation("PaymentConfirmer")
  requestedMaintenance           MaintenanceRequest[]           @relation("MaintenanceRequester")
  createdMaintenance             MaintenanceRequest[]           @relation("MaintenanceCreator")
  assignedMaintenance            MaintenanceRequest[]           @relation("MaintenanceTechnician")
  maintenanceAssignments         MaintenanceRequest[]           @relation("MaintenanceAssigner")
  maintenanceUpdates             MaintenanceUpdate[]            @relation("MaintenanceUpdateActor")
  requestedServices              ServiceRequest[]               @relation("ServiceRequester")
  createdServices                ServiceRequest[]               @relation("ServiceCreator")
  assignedServices               ServiceRequest[]               @relation("ServiceAssignee")
  serviceRequestUpdates          ServiceRequestUpdate[]         @relation("ServiceRequestUpdateActor")
  amenityBookings                AmenityBooking[]               @relation("AmenityBooker")
  reviewedAmenityBookings        AmenityBooking[]               @relation("AmenityReviewer")
  processedAmenityBookings       AmenityBooking[]               @relation("AmenityProcessor")
  announcements                  Announcement[]                 @relation("AnnouncementAuthor")
  notifications                  Notification[]
  deviceInstallations            DeviceInstallation[]
  handledHousingInquiries        HousingInquiry[]               @relation("HousingInquiryHandler")
  staffBuildingAssignments       StaffBuildingAssignment[]      @relation("StaffBuildingAssignmentUser")
  createdBuildingAssignments     StaffBuildingAssignment[]      @relation("StaffBuildingAssignmentAssigner")
  auditLogs                      AuditLog[]                     @relation("AuditLogActor")
  refreshSessions                RefreshSession[]

  @@index([status])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(20)
  resource   String   @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(100)
  path       String   @db.VarChar(500)
  statusCode Int      @map("status_code")
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model RegistrationVerification {
  email        String   @id @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  codeHash     String   @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("registration_verifications")
}

model RefreshSession {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(500)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Building {
  id                String                    @id @default(uuid()) @db.Uuid
  code              String                    @unique @db.VarChar(30)
  name              String                    @db.VarChar(150)
  address           String                    @db.VarChar(500)
  floors            Int
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  apartments        Apartment[]
  securityIncidents SecurityIncident[]
  amenities         Amenity[]
  staffAssignments  StaffBuildingAssignment[]
  announcements     Announcement[]

  @@map("buildings")
}

model StaffBuildingAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  buildingId   String    @map("building_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  startDate    DateTime  @default(now()) @map("start_date") @db.Timestamptz(6)
  endDate      DateTime? @map("end_date") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User     @relation("StaffBuildingAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("StaffBuildingAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, buildingId])
  @@index([userId, isActive])
  @@index([buildingId, isActive])
  @@map("staff_building_assignments")
}

model Apartment {
  id                            String                         @id @default(uuid()) @db.Uuid
  buildingId                    String                         @map("building_id") @db.Uuid
  code                          String                         @db.VarChar(30)
  floor                         Int
  area                          Decimal                        @db.Decimal(10, 2)
  bedrooms                      Int
  status                        ApartmentStatus                @default(VACANT)
  createdAt                     DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  building                      Building                       @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  memberships                   ApartmentMembership[]
  residenceVerificationRequests ResidenceVerificationRequest[]
  householdMembers              HouseholdMember[]
  housingListings               HousingListing[]
  housingContracts              HousingContract[]
  temporaryStays                TemporaryStay[]
  securityIncidents             SecurityIncident[]
  invoices                      Invoice[]
  maintenanceRequests           MaintenanceRequest[]
  serviceRequests               ServiceRequest[]
  amenityBookings               AmenityBooking[]

  @@unique([buildingId, code])
  @@index([status])
  @@map("apartments")
}

model ApartmentMembership {
  id          String           @id @default(uuid()) @db.Uuid
  apartmentId String           @map("apartment_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        MembershipType
  status      MembershipStatus @default(ACTIVE)
  isPrimary   Boolean          @default(false) @map("is_primary")
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime?        @map("end_date") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  apartment   Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([apartmentId, status])
  @@index([userId, status])
  @@map("apartment_memberships")
}

model ResidenceVerificationRequest {
  id                String                      @id @default(uuid()) @db.Uuid
  userId            String                      @map("user_id") @db.Uuid
  apartmentId       String                      @map("apartment_id") @db.Uuid
  type              MembershipType
  status            ResidenceVerificationStatus @default(PENDING)
  startDate         DateTime                    @map("start_date") @db.Date
  verificationBasis String?                     @map("verification_basis") @db.VarChar(100)
  note              String?                     @db.Text
  reviewNote        String?                     @map("review_note") @db.Text
  reviewedById      String?                     @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?                   @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User                        @relation("ResidenceVerificationRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy        User?                       @relation("ResidenceVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  apartment         Apartment                   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([apartmentId, status])
  @@index([status, createdAt])
  @@map("residence_verification_requests")
}

model HouseholdMember {
  id           String                @id @default(uuid()) @db.Uuid
  apartmentId  String                @map("apartment_id") @db.Uuid
  createdById  String                @map("created_by_id") @db.Uuid
  fullName     String                @map("full_name") @db.VarChar(150)
  dateOfBirth  DateTime?             @map("date_of_birth") @db.Date
  phone        String?               @db.VarChar(20)
  relationship String                @db.VarChar(100)
  startDate    DateTime              @map("start_date") @db.Date
  endDate      DateTime?             @map("end_date") @db.Date
  status       HouseholdMemberStatus @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  apartment    Apartment             @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("HouseholdMemberCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([apartmentId, status])
  @@index([createdById])
  @@map("household_members")
}

model HousingListing {
  id              String                 @id @default(uuid()) @db.Uuid
  apartmentId     String                 @map("apartment_id") @db.Uuid
  submittedById   String                 @map("submitted_by_id") @db.Uuid
  reviewedById    String?                @map("reviewed_by_id") @db.Uuid
  title           String                 @db.VarChar(200)
  description     String                 @db.Text
  transactionType HousingTransactionType @map("transaction_type")
  price           Decimal                @db.Decimal(15, 2)
  deposit         Decimal                @default(0) @db.Decimal(15, 2)
  availableFrom   DateTime               @map("available_from") @db.Date
  imageUrls       Json?                  @map("image_urls")
  ownerSubmitted  Boolean                @default(false) @map("owner_submitted")
  status          HousingListingStatus   @default(PENDING_APPROVAL)
  reviewNote      String?                @map("review_note") @db.Text
  reviewedAt      DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  closedAt        DateTime?              @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  apartment       Apartment              @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  submittedBy     User                   @relation("ListingSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy      User?                  @relation("ListingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  applications    HousingApplication[]
  inquiries       HousingInquiry[]

  @@index([apartmentId, status])
  @@index([transactionType, status])
  @@index([submittedById])
  @@map("housing_listings")
}

model HousingInquiry {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique @db.VarChar(30)
  listingId   String               @map("listing_id") @db.Uuid
  fullName    String               @map("full_name") @db.VarChar(150)
  phone       String               @db.VarChar(20)
  email       String?              @db.VarChar(255)
  message     String?              @db.Text
  status      HousingInquiryStatus @default(NEW)
  handledById String?              @map("handled_by_id") @db.Uuid
  handledAt   DateTime?            @map("handled_at") @db.Timestamptz(6)
  staffNote   String?              @map("staff_note") @db.Text
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  listing     HousingListing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  handledBy   User?                @relation("HousingInquiryHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([listingId, status])
  @@index([status, createdAt])
  @@index([phone])
  @@map("housing_inquiries")
}

model HousingApplication {
  id                 String                   @id @default(uuid()) @db.Uuid
  code               String                   @unique @db.VarChar(30)
  listingId          String                   @map("listing_id") @db.Uuid
  applicantId        String                   @map("applicant_id") @db.Uuid
  preferredStartDate DateTime                 @map("preferred_start_date") @db.Date
  preferredEndDate   DateTime?                @map("preferred_end_date") @db.Date
  note               String?                  @db.Text
  status             HousingApplicationStatus @default(PENDING)
  reviewedById       String?                  @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  reviewNote         String?                  @map("review_note") @db.Text
  submittedAt        DateTime                 @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  listing            HousingListing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  applicant          User                     @relation("HousingApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewedBy         User?                    @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  contract           HousingContract?

  @@index([listingId, status])
  @@index([applicantId, status])
  @@map("housing_applications")
}

model HousingContract {
  id                 String                 @id @default(uuid()) @db.Uuid
  contractNumber     String                 @unique @map("contract_number") @db.VarChar(50)
  applicationId      String                 @unique @map("application_id") @db.Uuid
  apartmentId        String                 @map("apartment_id") @db.Uuid
  ownerId            String                 @map("owner_id") @db.Uuid
  customerId         String                 @map("customer_id") @db.Uuid
  recordedById       String                 @map("recorded_by_id") @db.Uuid
  transactionType    HousingTransactionType @map("transaction_type")
  agreedPrice        Decimal                @map("agreed_price") @db.Decimal(15, 2)
  deposit            Decimal                @default(0) @db.Decimal(15, 2)
  signedAt           DateTime               @map("signed_at") @db.Date
  effectiveStartDate DateTime               @map("effective_start_date") @db.Date
  effectiveEndDate   DateTime?              @map("effective_end_date") @db.Date
  status             HousingContractStatus  @default(SIGNED)
  note               String?                @db.Text
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  application        HousingApplication     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  apartment          Apartment              @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  owner              User                   @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  customer           User                   @relation("ContractCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy         User                   @relation("ContractRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([apartmentId, status])
  @@index([ownerId])
  @@index([customerId])
  @@map("housing_contracts")
}

model TemporaryStay {
  id                     String              @id @default(uuid()) @db.Uuid
  apartmentId            String              @map("apartment_id") @db.Uuid
  declaredById           String              @map("declared_by_id") @db.Uuid
  reviewedById           String?             @map("reviewed_by_id") @db.Uuid
  checkedInById          String?             @map("checked_in_by_id") @db.Uuid
  checkedOutById         String?             @map("checked_out_by_id") @db.Uuid
  guestFullName          String              @map("guest_full_name") @db.VarChar(150)
  guestDateOfBirth       DateTime?           @map("guest_date_of_birth") @db.Date
  guestPhone             String?             @map("guest_phone") @db.VarChar(20)
  relationshipToResident String?             @map("relationship_to_resident") @db.VarChar(100)
  startDate              DateTime            @map("start_date") @db.Date
  endDate                DateTime            @map("end_date") @db.Date
  purpose                String?             @db.VarChar(500)
  status                 TemporaryStayStatus @default(PENDING)
  reviewNote             String?             @map("review_note") @db.Text
  reviewedAt             DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  checkedInAt            DateTime?           @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt           DateTime?           @map("checked_out_at") @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  apartment              Apartment           @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  declaredBy             User                @relation("TemporaryStayDeclarer", fields: [declaredById], references: [id], onDelete: Restrict)
  reviewedBy             User?               @relation("TemporaryStayReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
