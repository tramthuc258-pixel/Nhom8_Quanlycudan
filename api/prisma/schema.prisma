model SecurityIncident {
  id             String                   @id @default(uuid()) @db.Uuid
  code           String                   @unique @db.VarChar(30)
  buildingId     String                   @map("building_id") @db.Uuid
  apartmentId    String?                  @map("apartment_id") @db.Uuid
  reportedById   String                   @map("reported_by_id") @db.Uuid
  resolvedById   String?                  @map("resolved_by_id") @db.Uuid
  assignedToId   String?                  @map("assigned_to_id") @db.Uuid
  assignedById   String?                  @map("assigned_by_id") @db.Uuid
  type           SecurityIncidentType
  title          String                   @db.VarChar(200)
  description    String                   @db.Text
  location       String?                  @db.VarChar(255)
  occurredAt     DateTime                 @map("occurred_at") @db.Timestamptz(6)
  status         SecurityIncidentStatus   @default(REPORTED)
  resolutionNote String?                  @map("resolution_note") @db.Text
  resolvedAt     DateTime?                @map("resolved_at") @db.Timestamptz(6)
  assignedAt     DateTime?                @map("assigned_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  building       Building                 @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  apartment      Apartment?               @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  reportedBy     User                     @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy     User?                    @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  assignedTo     User?                    @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy     User?                    @relation("IncidentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
