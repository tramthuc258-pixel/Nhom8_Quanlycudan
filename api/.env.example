DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Firebase Admin dùng để API gửi push notification. Tải service-account JSON
# từ Firebase Console và trỏ tới file bằng đường dẫn tuyệt đối (dùng dấu /).
GOOGLE_APPLICATION_CREDENTIALS="D:/path/to/firebase-service-account.json"

# Một hoặc nhiều OAuth client ID, phân tách bằng dấu phẩy.
# API dùng các ID này để xác minh Google ID token từ Flutter.
GOOGLE_CLIENT_IDS="your-web-client-id.apps.googleusercontent.com"

# Cấu hình gửi OTP đăng ký và mã quên mật khẩu. Khi phát triển có thể để trống:
# Nếu chưa có SMTP, API trả developmentCode chỉ trong môi trường phát triển.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Homie <no-reply@example.com>"

# Chỉ dùng để tạo tài khoản quản trị khi chạy seed.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_FULL_NAME="Quản trị viên Homie"

# Chỉ bật khi cần nạp bộ dữ liệu nghiệm thu ban đầu. Không dùng trong vận hành.
# Mật khẩu này không được dùng thay cho luồng tạo tài khoản/thư mời chính thức.
SEED_INITIAL_ACCOUNT_PASSWORD="replace-with-an-initial-password"

# Supabase Storage: lấy service_role key trong Project Settings > API.
# Chỉ lưu service role ở backend, tuyệt đối không đưa vào Flutter.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace-with-server-only-key"
# Chỉ dùng cho project cũ chưa có secret key mới:
# SUPABASE_SERVICE_ROLE_KEY="replace-with-legacy-service-role-key"
SUPABASE_STORAGE_BUCKET="homie-files"

# Danh sách origin web được phép, phân cách bằng dấu phẩy. Android native
# không gửi Origin nên không bị ảnh hưởng.
CORS_ORIGINS="http://localhost:8080,http://localhost:3000"

# Tài khoản nhận chuyển khoản phí cư dân. Đây là thông tin được hiển thị
# công khai cho người đã đăng nhập và không phải khóa bí mật.
BANK_TRANSFER_BANK_NAME=""
# Mã BIN hoặc mã NAPAS của ngân hàng, ví dụ Vietcombank là VCB/970436.
BANK_TRANSFER_BANK_ID=""
BANK_TRANSFER_ACCOUNT_NUMBER=""
BANK_TRANSFER_ACCOUNT_NAME=""
BANK_TRANSFER_BRANCH=""
BANK_TRANSFER_CONTENT_PREFIX="HOMIE"
# Tùy chọn: URL ảnh QR chuyển khoản do ban quản lý cung cấp.
BANK_TRANSFER_QR_URL=""

# VNPAY Sandbox. Đăng ký merchant thử nghiệm tại sandbox.vnpayment.vn.
# Return URL được mở trên trình duyệt của người dùng. IPN URL phải là HTTPS
# công khai và cần khai báo trong cấu hình merchant VNPAY.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/payments/vnpay/return"
VNPAY_IPN_URL="https://your-public-domain.example/api/payments/vnpay/ipn"
# Chỉ bật khi demo Sandbox; Return có chữ ký hợp lệ sẽ xác nhận nếu IPN chưa tới.
VNPAY_SANDBOX_RETURN_CONFIRMATION="false"

# Chỉ dùng khi chạy script tạo dữ liệu minh họa cho một cư dân.
SHOWCASE_RESIDENT_EMAIL=""
